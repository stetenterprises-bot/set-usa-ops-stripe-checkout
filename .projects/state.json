{
  "version": 1,
  "providers": {
    "privy": {
      "name": "Privy"
    },
    "railway": {
      "name": "Railway"
    },
    "render": {
      "name": "Render"
    }
  },
  "resources": {
    "agentic-events-db": {
      "name": "agentic-events-db",
      "providerName": "Render",
      "serviceId": "postgres"
    },
    "checkout-hosting": {
      "name": "checkout-hosting",
      "providerName": "Railway",
      "serviceId": "hosting"
    },
    "mpp-hosting": {
      "name": "mpp-hosting",
      "providerName": "Render",
      "serviceId": "web-service"
    },
    "privy-app": {
      "name": "privy-app",
      "providerName": "Privy",
      "serviceId": "app"
    },
    "privy-plan": {
      "name": "privy-plan",
      "providerName": "Privy",
      "serviceId": "free"
    }
  },
  "environments": {
    "default": {
      "output": ".env.projects-default",
      "resources": []
    },
    "production": {
      "output": ".env.production",
      "resources": [
        {
          "resourceName": "agentic-events-db"
        },
        {
          "resourceName": "mpp-hosting"
        },
        {
          "resourceName": "privy-app"
        },
        {
          "resourceName": "privy-plan"
        }
      ]
    }
  }
}
