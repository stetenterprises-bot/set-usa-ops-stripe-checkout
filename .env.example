# Copy this file to .env.app and populate only test-mode credentials.
# Prefer a least-privilege test restricted key over a test secret key.
STRIPE_MODE=test
STRIPE_API_KEY=
# Browser-safe test publishable key for the embedded Checkout page.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFILE_ID=
# Optional. If blank, the server derives a dedicated challenge-binding key from STRIPE_API_KEY.
MPP_SECRET_KEY=
PORT=4242
APPLICATION_BASE_URL=http://localhost:4242
